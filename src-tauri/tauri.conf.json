{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taurrent",
  "version": "../package.json",
  "identifier": "com.rowvy.taurrent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Taurrent",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "BitTorrent client",
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "mimeType": "application/x-bittorrent",
        "name": "Torrent",
        "description": "BitTorrent file",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2QUQxMDMwMkFFODc0RDUKUldUVmRPZ3FNQkN0ZGxIQkVReVcxTE91eWRDVXVWVEk0NzN5TzJmTDJmdk9DaXhHVXMzeWF5NGwK",
      "endpoints": [
        "https://github.com/1rowvy/taurrent/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  }
}
